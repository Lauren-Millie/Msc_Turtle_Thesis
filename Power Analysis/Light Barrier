  filter(Variability == "Observed variability") %>%
  select(Effect, Sample_Size, Linear_Model_Power = Power)
Validation_Results <- Validation_Results %>%
  left_join(Original_Power, by = c("Effect", "Sample_Size")) %>%
  mutate(
    Permutation_Power_Percent = round(Permutation_Power * 100, 1),
    Linear_Model_Power_Percent = round(Linear_Model_Power * 100, 1),
    Difference_Percentage_Points = round(
      Permutation_Power_Percent - Linear_Model_Power_Percent, 1)
  )
print(Validation_Results)
