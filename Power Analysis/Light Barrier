# 4. Beach-stratified permutation validation
# ------------------------------------------------------------
# Retains the three original selected scenarios, with 500
# datasets per scenario and 999 within-beach permutations.
set.seed(456)
Validation_Scenarios <- data.frame(
  Effect = c(15, 12.94, 10),
  Sample_Size = c(80, 100, 160)
)
Validation_N_Simulations <- 500L
N_Permutations <- 999L

permutation_p <- function(d, n_perm = N_Permutations) {
  observed <- unname(coef(lm(Offset ~ Barrier + Beach, data = d))[
    "BarrierLight barrier"])
  permuted_effects <- replicate(n_perm, {
    p <- d
    # Permute barrier assignments independently within each beach.
    p$Barrier <- factor(
      ave(as.character(d$Barrier), d$Beach,
          FUN = function(x) sample(x, length(x), replace = FALSE)),
      levels = barrier_levels
    )
    unname(coef(lm(Offset ~ Barrier + Beach, data = p))[
      "BarrierLight barrier"])
  })
  (sum(abs(permuted_effects) >= abs(observed)) + 1) / (n_perm + 1)
}

Validation_Results <- Validation_Scenarios
Validation_Results$Permutation_Power <- NA_real_
for (i in seq_len(nrow(Validation_Results))) {
  scenario <- Validation_Results[i, ]
  cat("Validating scenario", i, "of", nrow(Validation_Results), "\n")
  detected <- replicate(Validation_N_Simulations, {
    d <- generate_study(scenario$Sample_Size, scenario$Effect,
                        Residual_SD, Beach_Means)
    permutation_p(d) < Alpha
  })
  Validation_Results$Permutation_Power[i] <- mean(detected)
}
